/* halo_harness.tui styles -- colors come from BridgeApp.get_css_variables()
   (tui/theme.py's `variables_for`), never hardcoded here, so a theme swap
   only ever needs a new palette dict, not a stylesheet edit. */

Screen {
    background: $bridge-bg;
    color: $bridge-text;
    layout: vertical;
}

#transcript {
    height: 1fr;
    width: 100%;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#transcript > * {
    margin: 0 0 1 0;
    width: 100%;
}

.user-message {
    color: $bridge-user;
    text-style: bold;
}

.system-note {
    color: $bridge-muted;
}

/* 2.0.0 Launch intro: "a dim first entry of the session" once it finishes
   typing -- same muted tone as a system note, never competing with real
   transcript content. */
.intro-line {
    color: $bridge-muted;
}

.system-note-error {
    color: $bridge-error;
    text-style: bold;
}

.system-note-command, .system-note-note, .system-note-replay {
    color: $bridge-muted;
}

.system-note-subagent {
    color: $bridge-accent;
}

.folded-history {
    color: $bridge-muted;
    text-style: italic;
    border: round $bridge-border;
    padding: 0 1;
}

.thinking-block {
    color: $bridge-thinking;
    text-style: italic;
    padding: 0 2;
}

AssistantText {
    color: $bridge-assistant;
}

/* H9 whole-tree review finding 11: a sub-agent's own streamed text/
   thinking blocks get a left border + the SAME accent color
   .system-note-subagent already uses for its start/end markers, so a
   child's output reads as its own grouped block within the transcript
   flow rather than blending into the main session's own text. */
.assistant-text-child {
    border-left: thick $bridge-accent;
    padding: 0 1;
}

.thinking-block-child {
    border-left: thick $bridge-accent;
}

.tool-card {
    color: $bridge-tool;
    border-left: thick $bridge-border;
    padding: 0 1;
}

.tool-card.tool-running {
    border-left: thick $bridge-warning;
}

.tool-card.tool-ok {
    border-left: thick $bridge-success;
}

.tool-card.tool-error {
    border-left: thick $bridge-error;
    color: $bridge-error;
}

.diff-view {
    border: round $bridge-border;
    padding: 0 1;
    margin-left: 2;
}

.permission-card, .question-card, .plan-card, .rewind-card {
    border: round $bridge-warning;
    background: $bridge-surface;
    padding: 1 2;
}

#which-key-overlay {
    max-height: 10;
    border: round $bridge-accent;
    background: $bridge-panel;
    color: $bridge-text;
    padding: 0 1;
}

.question-heading {
    text-style: bold;
    margin-top: 1;
}

#completion-popup {
    max-height: 8;
    border: round $bridge-border;
    background: $bridge-panel;
}

#bottom-dock {
    dock: bottom;
    height: auto;
    width: 100%;
}

#prompt-row {
    height: auto;
    max-height: 10;
    background: $bridge-surface;
    border-top: solid $bridge-border;
}

#prompt-glyph {
    width: 2;
    color: $bridge-accent;
    text-style: bold;
    content-align: center middle;
}

#prompt-input {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 8;
    background: $bridge-surface;
    border: none;
}

.status-bar {
    height: 1;
    width: 100%;
    background: $bridge-panel;
    color: $bridge-text;
}

.dialog-title {
    text-style: bold;
    margin-bottom: 1;
}
