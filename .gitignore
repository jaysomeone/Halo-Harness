state/
*.log
__pycache__/
.venv/
.pytest_cache/
*.pyc
.DS_Store
routes.json

# Local credentials and provider login state must never be published.
.env
.env.*
!.env.example
auth.json
.credentials.json

*.egg-info/
requirements.lock.tmp
